# ===================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env in your production environment (or set in Render / Railway / Vercel dashboard)
# ===================================================================

PORT=5000
NODE_ENV=production

# -------------------------------------------------------------------
# 1. PRODUCTION POSTGRESQL DATABASE (Neon / Supabase / Render)
# -------------------------------------------------------------------
DATABASE_URL=postgresql://your_prod_user:your_prod_password@your_neon_host.aws.neon.tech/your_db?sslmode=require

# -------------------------------------------------------------------
# 2. JWT SECURITY KEY
# -------------------------------------------------------------------
JWT_SECRET=supersecret_production_jwt_key_qa_workspace_2026

# -------------------------------------------------------------------
# 3. EMAIL DISPATCH CONFIGURATION (Brevo HTTP REST API - Port 443 HTTPS)
# Generate an API key (starts with xkeysib-...) in Brevo -> SMTP & API -> API Keys
# Make sure server IPs are permitted (or IP blocking disabled) in Brevo Security -> Authorised IPs
# -------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_v3_key_here

# Sender Identity (Use your Brevo verified sender email)
EMAIL_FROM_ADDRESS=your_verified_sender@example.com
EMAIL_FROM_NAME=QA Software Workspace
EMAIL_FROM="QA Software Workspace" <your_verified_sender@example.com>
EMAIL_USER=your_verified_sender@example.com

# -------------------------------------------------------------------
# 4. FRONTEND LIVE APPLICATION URL
# -------------------------------------------------------------------
FRONTEND_URL=https://your-live-frontend-domain.com
